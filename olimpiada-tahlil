<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Olimpiada natijalari tahlili — Qoʻshkoʻpir tumani</title>
<meta name="description" content="Qoʻshkoʻpir tumani fan olimpiadasi (tuman bosqichi) natijalarining maktablar, fanlar va sinflar kesimidagi batafsil tahlili.">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<style>
:root{
  --primary:#2563eb;--primary-dark:#1d4ed8;--secondary:#0ea5e9;--accent:#f59e0b;
  --dark:#0f172a;--light-bg:#f1f5f9;--text:#334155;--muted:#64748b;--line:#e2e8f0;
  --ok:#16a34a;--warn:#f59e0b;--bad:#dc2626;--violet:#7c3aed;--radius:18px;--tr:all .25s ease;
  --sh:0 10px 30px rgba(15,23,42,.08);
}
*{margin:0;padding:0;box-sizing:border-box;font-family:'Times New Roman',Times,serif}
html{scroll-behavior:smooth;scroll-padding-top:128px}
body{background:var(--light-bg);color:var(--text);line-height:1.55;overflow-x:hidden}
a{text-decoration:none;color:inherit}
button{cursor:pointer;border:0;background:none;font:inherit;color:inherit}

/* ===== yuqori panel ===== */
header.top{position:fixed;top:0;left:0;right:0;z-index:60;background:rgba(15,23,42,.9);backdrop-filter:blur(12px);border-bottom:1px solid rgba(255,255,255,.1)}
.top-in{max-width:1240px;margin:0 auto;padding:12px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.brand{display:flex;align-items:center;gap:11px;color:#fff;font-weight:700;font-size:1.05rem}
.brand i{width:38px;height:38px;border-radius:11px;background:linear-gradient(135deg,var(--primary),var(--secondary));display:flex;align-items:center;justify-content:center;font-size:17px}
.back{color:#fff;font-weight:700;font-size:.96rem;padding:9px 18px;border-radius:30px;border:1px solid rgba(255,255,255,.35);transition:var(--tr);white-space:nowrap}
.back:hover{background:#fff;color:var(--dark)}
nav.pills{background:rgba(255,255,255,.96);backdrop-filter:blur(8px);border-top:1px solid var(--line)}
.pills-in{max-width:1240px;margin:0 auto;padding:8px 20px;display:flex;gap:6px;overflow-x:auto;scrollbar-width:none}
.pills-in::-webkit-scrollbar{display:none}
.pills a{flex:none;padding:7px 15px;border-radius:30px;font-weight:700;font-size:.93rem;color:var(--muted);transition:var(--tr);display:flex;align-items:center;gap:7px}
.pills a:hover{background:#eef2ff;color:var(--primary)}
.pills a.on{background:var(--primary);color:#fff}
.pills a.red.on{background:var(--bad)}

/* ===== hero ===== */
.hero{position:relative;padding:176px 20px 128px;color:#fff;text-align:center;background:radial-gradient(1200px 500px at 80% -10%,rgba(14,165,233,.45),transparent 60%),radial-gradient(900px 500px at 0% 110%,rgba(124,58,237,.4),transparent 60%),linear-gradient(135deg,#0b1226 0%,#12296b 55%,#0369a1 100%);overflow:hidden}
.hero::before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:44px 44px;mask-image:radial-gradient(ellipse at center,#000 30%,transparent 75%);-webkit-mask-image:radial-gradient(ellipse at center,#000 30%,transparent 75%)}
.blob{position:absolute;border-radius:50%;filter:blur(70px);opacity:.5;animation:float 14s ease-in-out infinite}
.b1{width:340px;height:340px;background:#38bdf8;left:-80px;top:40px}
.b2{width:300px;height:300px;background:#a78bfa;right:-60px;bottom:-40px;animation-delay:-6s}
@keyframes float{0%,100%{transform:translate(0,0)}50%{transform:translate(40px,-30px)}}
.hero .chip{position:relative;display:inline-flex;align-items:center;gap:9px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.28);padding:8px 20px;border-radius:30px;font-weight:700;font-size:.95rem;margin-bottom:22px;backdrop-filter:blur(6px)}
.hero h1{position:relative;font-size:clamp(2.1rem,5.4vw,3.8rem);font-weight:800;line-height:1.1;letter-spacing:-1px;max-width:900px;margin:0 auto 16px}
.hero h1 span{background:linear-gradient(90deg,#fde68a,#fbbf24 40%,#fb923c);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p.sub{position:relative;max-width:720px;margin:0 auto;color:#cfe0ff;font-size:1.18rem}
.hero .stamp{position:relative;margin-top:26px;display:inline-flex;gap:10px;align-items:center;font-size:.98rem;color:#bcd2ff}
.hero .stamp i{color:#fde68a}

/* ===== umumiy ===== */
.wrap{max-width:1240px;margin:0 auto;padding:0 20px}
.kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:14px;margin-top:-72px;position:relative;z-index:3}
.kpi{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:20px;box-shadow:0 16px 36px rgba(2,8,23,.1);display:flex;align-items:center;gap:14px;transition:var(--tr);position:relative;overflow:hidden}
.kpi:hover{transform:translateY(-4px)}
.kpi::after{content:"";position:absolute;left:0;right:0;bottom:0;height:4px;background:var(--c)}
.kpi .ic{width:52px;height:52px;border-radius:15px;display:flex;align-items:center;justify-content:center;font-size:22px;flex:none;background:var(--bg);color:var(--c)}
.kpi .v{font-size:1.95rem;font-weight:800;color:var(--dark);line-height:1.05}
.kpi .v small{font-size:1rem;color:var(--muted);font-weight:700}
.kpi .l{font-size:.9rem;color:var(--muted);font-weight:700;margin-top:3px;line-height:1.2}

section.blk{margin-top:64px}
.sh{display:flex;align-items:flex-start;gap:16px;margin-bottom:22px}
.sh .bd{width:54px;height:54px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:23px;color:#fff;flex:none;background:linear-gradient(135deg,var(--primary),var(--secondary));box-shadow:0 10px 22px rgba(37,99,235,.35)}
.sh h2{font-size:clamp(1.5rem,3vw,2.05rem);color:var(--dark);font-weight:800;letter-spacing:-.4px;line-height:1.15}
.sh p{color:var(--muted);font-size:1.04rem;margin-top:4px;max-width:760px}
.card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--sh);padding:26px}
.grid2{display:grid;grid-template-columns:1.55fr 1fr;gap:20px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.grid2>*,.grid3>*{min-width:0}
@media(max-width:1100px){.kpis{grid-template-columns:repeat(3,1fr)}}
@media(max-width:980px){.grid2,.grid3{grid-template-columns:1fr}}
@media(max-width:560px){.hero .stamp{display:block;line-height:1.5}.tabs button{padding:8px 13px}.hist{gap:4px}.hb{display:none}.hbar b{font-size:.72rem;top:-18px}.kpis{grid-template-columns:repeat(2,1fr);gap:10px;margin-top:-56px}.kpi{flex-direction:column;align-items:flex-start;gap:10px;padding:16px}.kpi .v{font-size:1.65rem}.hero{padding:160px 16px 110px}.card{padding:18px}}
h3.ct{font-size:1.2rem;color:var(--dark);font-weight:800;margin-bottom:4px;display:flex;align-items:center;gap:9px}
.ct-s{color:var(--muted);font-size:.95rem;margin-bottom:18px}

/* gistogramma */
.hist{display:flex;align-items:flex-end;gap:8px;height:240px;position:relative;padding-top:20px}
.hcol{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;height:100%;position:relative}
.hbar{width:100%;border-radius:10px 10px 4px 4px;background:var(--c);height:0;transition:height 1.1s cubic-bezier(.2,.8,.2,1);position:relative;min-height:2px}
.hbar b{position:absolute;top:-22px;left:0;right:0;text-align:center;font-size:.92rem;color:var(--dark)}
.hlab{font-size:.78rem;color:var(--muted);margin-top:7px;font-weight:700;white-space:nowrap}
.zones{display:flex;gap:14px;flex-wrap:wrap;margin-top:16px}
.zn{display:flex;align-items:center;gap:7px;font-size:.92rem;font-weight:700;color:var(--text)}
.zn i{width:13px;height:13px;border-radius:4px;background:var(--c)}
.avgline{position:absolute;top:0;bottom:24px;border-left:2px dashed var(--dark);opacity:.75;pointer-events:none}
.avgline span{position:absolute;top:-4px;left:6px;font-size:.8rem;font-weight:800;background:var(--dark);color:#fff;padding:2px 8px;border-radius:8px;white-space:nowrap}

/* halqa */
.ring{--p:0;width:150px;height:150px;border-radius:50%;background:conic-gradient(var(--c) calc(var(--p)*1%),#e8edf5 0);display:grid;place-items:center;margin:0 auto;position:relative;transition:.1s}
.ring::before{content:"";position:absolute;inset:14px;background:#fff;border-radius:50%}
.ring div{position:relative;text-align:center}
.ring b{font-size:1.9rem;color:var(--dark);display:block;line-height:1}
.ring small{color:var(--muted);font-weight:700;font-size:.82rem}
.mini{display:grid;gap:13px;margin-top:22px}
.mrow{display:grid;grid-template-columns:112px 1fr 56px;gap:10px;align-items:center;font-size:.95rem;font-weight:700}
.mtrack{height:12px;background:#e8edf5;border-radius:10px;overflow:hidden}
.mfill{height:100%;border-radius:10px;background:linear-gradient(90deg,var(--c1,#38bdf8),var(--c2,#2563eb));width:0;transition:width 1.1s cubic-bezier(.2,.8,.2,1)}
.mrow span:last-child{text-align:right;color:var(--dark)}

/* tab tugmalar */
.tabs{display:inline-flex;background:#e8edf5;border-radius:30px;padding:4px;gap:2px;margin-bottom:18px;flex-wrap:wrap}
.tabs button{padding:8px 18px;border-radius:26px;font-weight:700;font-size:.95rem;color:var(--muted);transition:var(--tr)}
.tabs button.on{background:#fff;color:var(--primary);box-shadow:0 3px 10px rgba(15,23,42,.12)}

/* fan bar */
.fbars{display:grid;gap:9px}
.fr{display:grid;grid-template-columns:150px 1fr 50px;gap:12px;align-items:center;padding:7px 10px;border-radius:12px;cursor:pointer;transition:var(--tr);border:1px solid transparent}
.fr:hover{background:#f6f9ff}
.fr.on{background:#eef4ff;border-color:#c7d9ff}
.fr .nm{font-weight:700;color:var(--dark);font-size:.97rem;line-height:1.15}
.fr .nm small{display:block;color:var(--muted);font-weight:600;font-size:.8rem}
.ftrack{position:relative;height:20px;background:#edf1f8;border-radius:10px}
.ffill{position:absolute;left:0;top:0;bottom:0;border-radius:10px;width:0;background:var(--c);transition:width 1s cubic-bezier(.2,.8,.2,1)}
.fmark{position:absolute;top:-4px;bottom:-4px;border-left:2px dashed var(--dark);opacity:.6}
.fr .val{font-weight:800;color:var(--dark);text-align:right;font-size:1.02rem}
@media(max-width:620px){.fr{grid-template-columns:105px 1fr 42px;gap:8px}.fr .nm{font-size:.88rem}}
.detail h4{font-size:1.3rem;color:var(--dark);font-weight:800;margin-bottom:2px}
.dnum{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:16px 0}
.dn{background:#f6f9ff;border:1px solid #e1ebff;border-radius:14px;padding:12px 14px}
.dn b{display:block;font-size:1.55rem;color:var(--dark);line-height:1.1}
.dn span{font-size:.85rem;color:var(--muted);font-weight:700}
.dn.r{background:#fff5f5;border-color:#fed7d7}.dn.r b{color:var(--bad)}
.dn.g{background:#f0fdf4;border-color:#bbf7d0}.dn.g b{color:var(--ok)}
.q3{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:6px}
.qm{text-align:center}
.qm .tube{height:110px;width:44px;margin:0 auto;background:#edf1f8;border-radius:14px;position:relative;overflow:hidden}
.qm .tube i{position:absolute;left:0;right:0;bottom:0;height:0;background:var(--c);border-radius:14px;transition:height 1s cubic-bezier(.2,.8,.2,1)}
.qm b{display:block;margin-top:7px;font-size:1.05rem;color:var(--dark)}
.qm span{font-size:.8rem;color:var(--muted);font-weight:700;line-height:1.1;display:block}

/* mini gistogramma */
.mh{display:flex;gap:5px;align-items:flex-end;height:90px}
.mhc{flex:1;height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center}
.mhc i{width:100%;background:var(--c);border-radius:5px 5px 2px 2px;height:0;transition:height 1s cubic-bezier(.2,.8,.2,1);min-height:2px;display:block}
.mhc span{font-size:.72rem;color:var(--muted);font-weight:700;margin-top:4px}
/* ===== diqqat ===== */
.alert{background:linear-gradient(135deg,#7f1d1d 0%,#b91c1c 55%,#ea580c 100%);border-radius:var(--radius);color:#fff;padding:30px;position:relative;overflow:hidden;box-shadow:0 18px 40px rgba(185,28,28,.3)}
.alert::after{content:"\f071";font-family:"Font Awesome 6 Free";font-weight:900;position:absolute;right:-20px;bottom:-40px;font-size:230px;opacity:.1}
.alert h3{font-size:1.5rem;font-weight:800;margin-bottom:6px}
.alert p{color:#ffe4e0;max-width:760px}
.abig{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin-top:22px;position:relative}
.ab{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.25);border-radius:16px;padding:16px 18px;backdrop-filter:blur(4px)}
.ab b{font-size:2.2rem;font-weight:800;line-height:1;display:block}
.ab span{font-size:.93rem;color:#ffe4e0;font-weight:700}
.div{display:grid;gap:9px;margin-top:10px}
.dr{display:grid;grid-template-columns:150px 1fr 90px;gap:12px;align-items:center;font-size:.97rem}
.dr .nm{font-weight:700;color:var(--dark)}
.dtrack{position:relative;height:22px;background:linear-gradient(90deg,#fee2e2,#fff 60%);border-radius:11px;overflow:hidden;border:1px solid #fecaca}
.dfill{position:absolute;top:0;bottom:0;right:0;width:0;border-radius:11px;background:linear-gradient(270deg,#ef4444,#f97316);transition:width 1s cubic-bezier(.2,.8,.2,1)}
.dr .num{text-align:right;font-weight:800;color:var(--bad)}
.dr .num small{display:block;font-size:.78rem;color:var(--muted);font-weight:700}
@media(max-width:620px){.dr{grid-template-columns:96px 1fr 70px;gap:8px}}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.chip2{background:#fff5f5;border:1px solid #fecaca;color:#991b1b;font-weight:700;border-radius:30px;padding:6px 14px;font-size:.93rem}
.chip2 b{color:var(--bad)}
table.t{width:100%;border-collapse:collapse;font-size:.97rem}
table.t th{background:#f8fafc;color:var(--muted);font-weight:800;text-align:left;padding:10px 12px;font-size:.84rem;text-transform:uppercase;letter-spacing:.4px;border-bottom:2px solid var(--line);white-space:nowrap}
table.t td{padding:10px 12px;border-bottom:1px solid var(--line);vertical-align:middle}
table.t tr:hover td{background:#fafcff}
.tw{overflow-x:auto}
.badge{display:inline-block;padding:3px 10px;border-radius:20px;font-weight:800;font-size:.86rem}
.bd-r{background:#fee2e2;color:#b91c1c}.bd-g{background:#dcfce7;color:#15803d}.bd-a{background:#fef3c7;color:#b45309}.bd-b{background:#dbeafe;color:#1d4ed8}

/* ===== maktablar ===== */
.tool{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-bottom:16px}
.search{flex:1;min-width:210px;position:relative}
.search input{width:100%;padding:12px 16px 12px 42px;border-radius:30px;border:1.5px solid var(--line);font-size:1rem;outline:none;background:#fff;transition:var(--tr)}
.search input:focus{border-color:var(--primary);box-shadow:0 0 0 4px rgba(37,99,235,.12)}
.search i{position:absolute;left:16px;top:50%;transform:translateY(-50%);color:var(--muted)}
.sel{padding:11px 16px;border-radius:30px;border:1.5px solid var(--line);background:#fff;font-size:.98rem;font-weight:700;color:var(--dark);outline:none}
table.sc{width:100%;border-collapse:separate;border-spacing:0 6px;min-width:860px}
table.sc th{font-size:.8rem;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;font-weight:800;padding:6px 12px;text-align:left;cursor:pointer;white-space:nowrap;user-select:none}
table.sc th:hover{color:var(--primary)}
table.sc td{background:#fff;padding:12px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);vertical-align:middle}
table.sc td:first-child{border-left:1px solid var(--line);border-radius:14px 0 0 14px}
table.sc td:last-child{border-right:1px solid var(--line);border-radius:0 14px 14px 0}
table.sc tr.row{cursor:pointer;transition:var(--tr)}
table.sc tr.row:hover td{background:#f6f9ff}
.rk{width:34px;height:34px;border-radius:11px;display:grid;place-items:center;font-weight:800;color:var(--dark);background:#eef2f7}
.rk.r1{background:linear-gradient(135deg,#fde68a,#f59e0b);color:#78350f}
.rk.r2{background:linear-gradient(135deg,#f1f5f9,#cbd5e1);color:#334155}
.rk.r3{background:linear-gradient(135deg,#fed7aa,#ea8a3a);color:#7c2d12}
.sn{font-weight:800;color:var(--dark);font-size:1.02rem}
.sn small{display:block;color:var(--muted);font-weight:600;font-size:.82rem}
.cb{display:flex;align-items:center;gap:9px;min-width:130px}
.cb .tr{flex:1;height:10px;background:#e8edf5;border-radius:8px;position:relative;overflow:visible}
.cb .fl{height:100%;border-radius:8px}
.cb .mk{position:absolute;top:-4px;bottom:-4px;border-left:2px dashed #0f172a;opacity:.55}
.cb b{min-width:44px;text-align:right;color:var(--dark)}
.md{display:flex;gap:6px;font-weight:800;color:var(--dark);white-space:nowrap}
.md span{min-width:36px}
tr.exp td{padding:0!important;border:0!important;background:transparent!important}
.expin{background:linear-gradient(180deg,#f6f9ff,#fff);border:1px solid #dbe7ff;border-radius:14px;margin:-2px 0 6px;padding:16px 18px;display:none}
.expin.open{display:block;animation:fd .35s ease}
@keyframes fd{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}
.fchips{display:flex;flex-wrap:wrap;gap:8px}
.fch{border-radius:12px;padding:7px 12px;font-weight:800;font-size:.92rem;color:#fff;background:var(--c);text-shadow:0 1px 1px rgba(0,0,0,.2)}
.fch small{font-weight:700;opacity:.85}

/* ===== xarita ===== */
.heat{overflow:auto;max-height:640px;border-radius:14px;border:1px solid var(--line)}
table.h{border-collapse:separate;border-spacing:0;font-size:.9rem;min-width:900px;width:100%}
table.h th{position:sticky;top:0;background:#0f172a;color:#fff;padding:10px 6px;font-size:.8rem;z-index:2;white-space:nowrap}
table.h th:first-child{left:0;z-index:3;text-align:left;padding-left:14px}
table.h td{padding:8px 4px;text-align:center;font-weight:800;border-bottom:1px solid #fff;border-right:1px solid #fff;color:#0f172a;min-width:62px}
table.h td:first-child{position:sticky;left:0;background:#fff;text-align:left;padding-left:14px;z-index:1;border-right:2px solid var(--line);white-space:nowrap}
table.h td.nm{color:var(--dark)}
.lg{display:flex;align-items:center;gap:10px;margin-top:14px;font-size:.9rem;font-weight:700;color:var(--muted)}
.lgbar{height:12px;flex:1;max-width:320px;border-radius:8px;background:linear-gradient(90deg,#f8696b,#ffeb84,#63be7b)}

/* ===== davomat ===== */
.att{display:grid;gap:7px;margin-top:6px}
.ar{display:grid;grid-template-columns:130px 1fr 130px;gap:12px;align-items:center;font-size:.95rem}
.ar .nm{font-weight:700;color:var(--dark)}
.atr{height:16px;background:#e8edf5;border-radius:10px;overflow:hidden}
.afl{height:100%;border-radius:10px;width:0;transition:width 1s cubic-bezier(.2,.8,.2,1)}
.ar .nn{text-align:right;font-weight:800;color:var(--dark)}.ar .nn small{color:var(--muted);font-weight:700}
@media(max-width:620px){.ar{grid-template-columns:92px 1fr 88px;gap:8px}}

/* ===== yutuqlar ===== */
.podium{display:grid;grid-template-columns:1fr 1.1fr 1fr;gap:14px;align-items:end;margin-top:8px}
.pd{border-radius:20px 20px 8px 8px;text-align:center;padding:20px 12px 18px;color:#fff;position:relative;box-shadow:0 14px 30px rgba(2,8,23,.18)}
.pd .no{font-size:2.6rem;font-weight:800;line-height:1;opacity:.95}
.pd .sname{font-size:1.1rem;font-weight:800;margin-top:6px;line-height:1.15}
.pd .sv{font-size:2rem;font-weight:800;margin-top:6px}
.pd .sd{font-size:.86rem;opacity:.9;font-weight:700}
.pd i.cr{position:absolute;top:-20px;left:50%;transform:translateX(-50%);font-size:30px;color:#fde047;filter:drop-shadow(0 4px 6px rgba(0,0,0,.3))}
.p1{background:linear-gradient(160deg,#f59e0b,#b45309);min-height:240px}
.p2{background:linear-gradient(160deg,#94a3b8,#475569);min-height:196px}
.p3{background:linear-gradient(160deg,#fb923c,#c2410c);min-height:176px}
@media(max-width:560px){.podium{grid-template-columns:1fr;}.p1,.p2,.p3{min-height:0}}
.lb{display:grid;gap:9px}
.lbr{display:grid;grid-template-columns:28px 150px 1fr 40px;gap:10px;align-items:center;font-size:.96rem}
.lbr .nm{font-weight:700;color:var(--dark)}
.stk{display:flex;height:20px;border-radius:10px;overflow:hidden;background:#edf1f8}
.stk i{display:block;height:100%;width:0;transition:width 1s cubic-bezier(.2,.8,.2,1)}
.tcards{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px}
.tc{border:1px solid var(--line);border-radius:16px;padding:14px 16px;background:linear-gradient(180deg,#fff,#fafcff);display:flex;gap:12px;align-items:center}
.tc .av{width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--violet));color:#fff;display:grid;place-items:center;font-weight:800;font-size:1.1rem;flex:none}
.tc b{color:var(--dark);font-size:.98rem;line-height:1.2;display:block}
.tc small{color:var(--muted);font-weight:700;font-size:.85rem}


/* ===== goliblar ===== */
.wtabs{display:inline-flex;background:#e8edf5;border-radius:30px;padding:4px;gap:2px;margin-bottom:18px;flex-wrap:wrap}
.wtabs button{padding:8px 16px;border-radius:26px;font-weight:700;font-size:.94rem;color:var(--muted);transition:var(--tr)}
.wtabs button.on{background:#fff;color:#b45309;box-shadow:0 3px 10px rgba(15,23,42,.12)}
.pl{display:inline-grid;place-items:center;width:34px;height:34px;border-radius:11px;font-weight:800;color:#fff}
.pl1{background:linear-gradient(135deg,#fbbf24,#d97706)}.pl2{background:linear-gradient(135deg,#cbd5e1,#64748b)}.pl3{background:linear-gradient(135deg,#fdba74,#c2410c)}
.bb{display:flex;align-items:center;gap:8px;min-width:120px}.bb i{display:block;height:9px;border-radius:6px;background:linear-gradient(90deg,#fbbf24,#f59e0b)}.bb b{color:var(--dark)}
.mcards{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px}
.mc{border:1px solid #fde7b0;background:linear-gradient(180deg,#fffdf5,#fff);border-radius:18px;padding:18px}
.mc .mt{display:flex;align-items:center;gap:12px;margin-bottom:10px}
.mc .mt .av{width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,#f59e0b,#dc2626);color:#fff;display:grid;place-items:center;font-weight:800;flex:none}
.mc .mt b{display:block;color:var(--dark);line-height:1.2}.mc .mt small{color:var(--muted);font-weight:700}
.mc .it{display:flex;gap:10px;align-items:center;padding:7px 0;border-top:1px dashed #f1e2b8;font-size:.95rem}
.mc .it .pl{width:28px;height:28px;border-radius:9px;font-size:.88rem}
.mc .it span{flex:1;color:var(--text)}.mc .it b{color:var(--dark)}
.gp{display:inline-block;min-width:38px;text-align:center;padding:2px 8px;border-radius:20px;font-weight:800;font-size:.88rem}
.gp.s{background:#fef3c7;color:#b45309}.gp.l{background:#dcfce7;color:#15803d}.gp.n{background:#f1f5f9;color:#475569}
/* orin olmagan */
.nwg{display:grid;grid-template-columns:repeat(auto-fill,minmax(285px,1fr));gap:14px}
.nw{background:#fff;border:1px solid var(--line);border-radius:18px;padding:18px;position:relative;overflow:hidden;box-shadow:var(--sh);transition:var(--tr)}
.nw:hover{transform:translateY(-3px)}
.nw::before{content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:linear-gradient(180deg,#38bdf8,#6366f1)}
.nw h4{font-size:1.22rem;color:var(--dark);font-weight:800}
.nw .bp{display:flex;align-items:center;gap:12px;margin:10px 0 8px}
.nw .bp .no{min-width:54px;height:54px;border-radius:16px;background:linear-gradient(135deg,#e0e7ff,#dbeafe);color:#3730a3;display:grid;place-items:center;font-weight:800;font-size:1.35rem;line-height:1;text-align:center}
.nw .bp .no small{display:block;font-size:.66rem;opacity:.75;font-weight:700}
.nw .bp div:last-child{font-size:.93rem;color:var(--text)}.nw .bp b{color:var(--dark);display:block;font-size:1rem}
.nw .st{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:6px;text-align:center}
.nw .st div{background:#f6f9ff;border-radius:10px;padding:7px 2px}.nw .st b{display:block;font-size:1.05rem;color:var(--dark);line-height:1.1}.nw .st span{font-size:.7rem;color:var(--muted);font-weight:700}
.hintbox{background:linear-gradient(135deg,#eef2ff,#f0f9ff);border:1px solid #c7d2fe;border-radius:var(--radius);padding:18px 22px;color:#312e81;margin-bottom:18px;display:flex;gap:14px;align-items:flex-start}
.hintbox i{font-size:22px;margin-top:2px;color:#6366f1}
/* ===== xulosa ===== */
.ins{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:16px}
.in{border-radius:var(--radius);padding:22px;background:#fff;border:1px solid var(--line);box-shadow:var(--sh);position:relative;overflow:hidden}
.in::before{content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--c)}
.in i{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:var(--bg);color:var(--c);font-size:18px;margin-bottom:10px}
.in h4{color:var(--dark);font-size:1.12rem;font-weight:800;margin-bottom:5px}
.in p{font-size:.99rem}
.note{margin:36px 0 56px;background:#fffbeb;border:1px solid #fde68a;color:#92400e;border-radius:14px;padding:16px 20px;font-size:.96rem;display:flex;gap:12px}
.note i{margin-top:3px}
.note b{color:#78350f}

/* ===== footer ===== */
footer{background:var(--dark);color:#94a3b8;padding:60px 24px 30px;border-top:1px solid rgba(255,255,255,.1)}
.footer-container{max-width:1240px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:24px;padding-bottom:30px;border-bottom:1px solid rgba(255,255,255,.08)}
.footer-copy{text-align:center;font-size:.88rem;margin-top:24px}
.footer-emblem-card{display:flex;align-items:center;gap:18px}
.footer-emblem-img{width:84px;height:84px;border-radius:50%;border:2.5px solid #d4af37;box-shadow:0 0 22px rgba(212,175,55,.6);object-fit:cover;flex-shrink:0}
.footer-name{font-size:1.4rem;font-weight:800;color:#fff}
.footer-status{font-size:.95rem;font-weight:700;color:#d4af37;text-transform:uppercase;letter-spacing:.5px}
.footer-motto{font-size:.85rem;color:#cbd5e1;font-style:italic}
.fbtn{display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border-radius:12px;border:1.5px solid rgba(255,255,255,.3);color:#fff;font-weight:700;font-size:.95rem;transition:var(--tr)}
.fbtn:hover{background:#fff;color:var(--dark)}

/* animatsiya */
.rv{opacity:0;transform:translateY(26px);transition:opacity .8s ease,transform .8s ease}
.rv.in-v{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}.blob{animation:none}}
@media print{header.top,nav.pills,.tool,.hero .blob{display:none!important}.hero{padding:30px 20px}.kpis{margin-top:20px}.rv{opacity:1;transform:none}}
</style>
</head>
