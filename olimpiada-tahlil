 }else if(wTab=='fans'){
  b.innerHTML=`<div class="ct-s">1-oʻrin bali, eng yuqori ball va 1- hamda 2-oʻrin orasidagi farq (ball). <span class="gp s">≤1</span> — juda qattiq kurash, <span class="gp l">≥10</span> — aniq ustunlik</div>
   <div class="tw"><table class="t"><tr><th>Fan</th><th>1-oʻrinlar oʻrtacha bali</th><th>Eng yuqori ball</th><th>Farq: 9-sinf</th><th>10-sinf</th><th>11-sinf</th></tr>${W.fans.map(f=>{const gp=v=>`<span class="gp ${v<=1?'s':v>=10?'l':'n'}">${v===0?'—':f1(v)}</span>`;return `<tr><td><b>${f.fan}</b></td><td>${f1(f.avg1)}</td><td><div class="bb"><i style="width:${f.mx/50*100}px"></i><b>${f1(f.mx)}</b></div></td><td>${gp(f.gap9)}</td><td>${gp(f.gap10)}</td><td>${gp(f.gap11)}</td></tr>`}).join('')}</table></div>`;
 }else if(wTab=='sch'){
  const mx=Math.max(...W.schools.map(s=>s.total));
  b.innerHTML=`<div class="ct-s">Maktablar gʻolib oʻrinlar soni boʻyicha (noyob — nechta turli oʻquvchi gʻolib boʻlgan)</div>
   <div class="tw"><table class="t"><tr><th>№</th><th>Maktab</th><th>Jami</th><th>Taqsimot</th><th>1-oʻrin</th><th>2-oʻrin</th><th>3-oʻrin</th><th>Noyob oʻquvchi</th></tr>${W.schools.map((s,i)=>`<tr><td>${i+1}</td><td><b>${s.school}</b></td><td><b>${s.total}</b></td><td style="min-width:150px"><div class="stk" style="width:${s.total/mx*100}%"><i style="width:${s.g1/s.total*100}%;background:#f2b705"></i><i style="width:${s.g2/s.total*100}%;background:#94a3b8"></i><i style="width:${s.g3/s.total*100}%;background:#d9822b"></i></div></td><td>${s.g1||''}</td><td>${s.g2||''}</td><td>${s.g3||''}</td><td>${s.uniq}</td></tr>`).join('')}</table></div>`;
 }else{
  b.innerHTML=`<div class="tool"><div class="search"><i class="fa-solid fa-magnifying-glass"></i><input id="tq" placeholder="Ustoz yoki maktab nomi…" autocomplete="off"></div></div><div class="tw"><table class="t" id="ttb"></table></div>`;
  const dt=()=>{const q=($('#tq').value||'').trim().toLowerCase();$('#ttb').innerHTML='<tr><th>№</th><th>Oʻqituvchi</th><th>Maktab</th><th>Gʻolib</th><th>1-oʻrin</th><th>Tafsilot</th></tr>'+W.teachers.filter(t=>(t.name+' '+t.school).toLowerCase().includes(q)).map((t,i)=>`<tr><td>${i+1}</td><td><b>${t.name}</b></td><td>${t.school}</td><td><b>${t.n}</b></td><td>${t.g1||''}</td><td style="font-size:.9rem">${t.detail}</td></tr>`).join('')};
  $('#tq').addEventListener('input',dt);dt();
 }
}
$('#wtabs').addEventListener('click',e=>{const x=e.target.closest('button');if(!x)return;wTab=x.dataset.w;document.querySelectorAll('#wtabs button').forEach(b=>b.classList.toggle('on',b===x));drawW()});
drawW();
/* ===== orin olmagan maktablar ===== */
const NW=D.nowin;
const wtop=NW.filter(s=>s.top10>0).length;
$('#nwHint').innerHTML=`<b>${NW.length} ta maktab</b> hech bir fan va sinfda 1–3-oʻrinni egallamagan. ${wtop==NW.length?'Barchasining':'Ulardan <b>'+wtop+' tasining</b>'} oʻquvchilari kamida bir marta birinchi oʻntalikka kirgan — gʻolib oʻrinlarga yaqin turibdi. Eng yuqori natija koʻrsatgan maktablar roʻyxat boshida.`;
function drawNW(){
 const k=$('#nwSort').value;const L=[...NW];
 if(k=='avg')L.sort((a,b)=>b.avg-a.avg);else if(k=='avgLow')L.sort((a,b)=>a.avg-b.avg);else if(k=='pa')L.sort((a,b)=>b.pa-a.pa);
 $('#nwg').innerHTML=L.map(s=>`<div class="nw"><h4>${s.name}</h4><div class="bp"><div class="no">${s.bestPlace}<small>oʻrin</small></div><div><b>Eng yaxshi natija</b>${s.bestFan.replace(' va adabiyot','').replace(' va axborot texnologiyalari',' (IT)').replace('Davlat va huquq asoslari','Davlat va huquq')}, ${s.bestSinf}-sinf — ${f1(s.bestBall)} ball</div></div>
 <div class="st"><div><b>${s.pa}</b><span>ishtirokchi</span></div><div><b style="color:${colF(s.avg)}">${f1(s.avg)}</b><span>oʻrtacha</span></div><div><b>${s.top10||'—'}</b><span>top-10</span></div><div><b>${Math.round(s.attp)}%</b><span>davomat</span></div></div></div>`).join('');
}
$('#nwSort').addEventListener('change',drawNW);drawNW();
/* ===== xulosa ===== */
const bestF=[...D.fans].sort((a,b)=>b.avg-a.avg)[0],worstF=[...D.fans].sort((a,b)=>a.avg-b.avg)[0];
const topS=top3[0],t4=[...D.schools].sort((a,b)=>b.medals-a.medals).slice(0,4);
const noMed=D.schools.filter(s=>s.medals==0).length;
const lowAtt=[...D.schools].sort((a,b)=>a.attp-b.attp).slice(0,2);
const ins=[
 ['fa-bullseye','#2563eb','#eff6ff','Tuman darajasi',`Oʻrtacha ball ${f1(AVG)} (50 dan). Ishtirokchilarning ${Math.round(T.hi/T.part*100)}% i 30 va undan yuqori, ${Math.round(T.low/T.part*100)}% i esa 15 balldan past natija koʻrsatdi.`],
 ['fa-book','#16a34a','#f0fdf4','Fanlar',`Eng yuqori oʻrtacha — ${bestF.name} (${f1(bestF.avg)}), eng past — ${worstF.name} (${f1(worstF.avg)}). Fanlar orasidagi farq ${f1(bestF.avg-worstF.avg)} ball.`],
 ['fa-ranking-star','#f59e0b','#fffbeb','Yetakchi maktablar',`${topS.name} oʻrtacha ${f1(topS.avg)} ball bilan yetakchi. Gʻoliblarning ${Math.round(t4.reduce((a,s)=>a+s.medals,0)/T.medals*100)}% i toʻrtta maktabga (${t4.map(s=>s.name).join(', ')}) toʻgʻri keladi.`],
 ['fa-triangle-exclamation','#dc2626','#fef2f2','Eʼtibor talab qiladi',`${lc.length} ta maktabda ishtirokchilarning yarmidan koʻpi 15 balldan past olgan. ${low10.slice(0,3).map(s=>s.name).join(', ')} oʻrtacha ball boʻyicha eng past oʻrinlarda.`],
 ['fa-user-check','#0ea5e9','#f0f9ff','Davomat',`Umumiy davomat ${f1(ap)}%. ${lowAtt.map(s=>s.name+' ('+Math.round(s.attp)+'%)').join(' va ')} maktablarida davomat eng past.`],
 ['fa-medal','#7c3aed','#f5f3ff','Gʻoliblar geografiyasi',`${D.schools.length-noMed} ta maktabda kamida bitta gʻolib bor, ${noMed} ta maktabda esa gʻolib yoʻq — bu maktablarda tayyorgarlikni kuchaytirish zarur.`]];
$('#ins').innerHTML=ins.map(x=>`<div class="in" style="--c:${x[1]};--bg:${x[2]}"><i class="fa-solid ${x[0]}"></i><h4>${x[3]}</h4><p>${x[4]}</p></div>`).join('');
/* ===== animatsiyalar ===== */
function anim(root){
 root.querySelectorAll('.hbar[data-h]').forEach(e=>e.style.height=e.dataset.h*0.86+'%');
 root.querySelectorAll('.mfill[data-w],.dfill[data-w],.afl[data-w],.stk i[data-w]').forEach(e=>e.style.width=e.dataset.w+'%');
 root.querySelectorAll('.ffill[data-w]').forEach(e=>e.style.width=e.dataset.w+'%');
}
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in-v');anim(e.target);io.unobserve(e.target)}}),{threshold:.12});
document.querySelectorAll('.rv').forEach(e=>io.observe(e));
/* sticky pills */
const secs=[...document.querySelectorAll('section.blk')];const pl=[...document.querySelectorAll('#pills a')];
addEventListener('scroll',()=>{let cur=secs[0].id;secs.forEach(s=>{if(s.getBoundingClientRect().top<180)cur=s.id});pl.forEach(a=>a.classList.toggle('on',a.getAttribute('href')=='#'+cur))},{passive:true});
</script>
